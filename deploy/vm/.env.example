# Copy to deploy/vm/.env (git ignored). Read on your machine by `make vm-*`;
# values are sent to the remote Docker host, nothing is copied to it as a file.

# Target host. Any cloud VM with Docker and SSH access. Leave empty for the local Docker.
DOCKER_HOST=ssh://root@203.0.113.10

# Traefik
ACME_EMAIL=
TRAEFIK_HOST=traefik.example.com
# htpasswd -nbB admin 'a strong password'. Keep the single quotes: the hash contains $.
TRAEFIK_AUTH='admin:$2y$05$replace.with.your.hash'

# Platform
FLEET_HOST=fleet.example.com
ROBOTS_HOST=robots.example.com
# CIDRs allowed to reach the robot endpoint, comma separated.
ROBOTS_ALLOWLIST=127.0.0.1/32
JWT_SECRET=
POSTGRES_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
TELEMETRY_RETENTION_DAYS=2
SIMULATOR_ROBOTS=200

# Image version: latest, or sha-<commit> from CI for a pinned release.
IMAGE_TAG=latest
