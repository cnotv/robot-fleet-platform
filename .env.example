# Copy to .env next to docker-compose.yml. Every value below has a local default;
# set all of them on any host reachable from the internet.

# Long random string used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=
POSTGRES_PASSWORD=

# First admin, created only when the users table is empty.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public URLs as seen by the browser. PUBLIC_API_URL is baked into the dashboard at build time.
PUBLIC_DASHBOARD_URL=https://app.example.com
PUBLIC_API_URL=https://api.example.com

# Interface the published ports bind to. Keep 127.0.0.1 behind a reverse proxy.
BIND_ADDR=127.0.0.1
