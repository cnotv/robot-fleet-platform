generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  operator
  viewer
}

model Company {
  id        String   @id @default(cuid())
  name      String   @unique
  users     User[]
  robots    Robot[]
  createdAt DateTime @default(now())
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(viewer)
  company      Company  @relation(fields: [companyId], references: [id])
  companyId    String
  createdAt    DateTime @default(now())

  @@index([companyId])
}

// Static inventory. Live state lives in Redis, keyed by the same robot id.
model Robot {
  id             String   @id
  serialNumber   String   @unique
  model          String
  firmware       String
  maxSpeedMps    Float
  batteryWh      Int
  company        Company  @relation(fields: [companyId], references: [id])
  companyId      String
  commissionedAt DateTime @default(now())

  @@index([companyId])
}
