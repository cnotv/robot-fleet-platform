generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  operator
  viewer
}

enum RobotKind {
  cleaning
  delivery
  room_service
  reception
}

model Company {
  id        String   @id @default(cuid())
  name      String   @unique
  users     User[]
  sites     Site[]
  robots    Robot[]
  createdAt DateTime @default(now())
}

// A physical location where robots are deployed, such as one hotel.
model Site {
  id        String  @id
  name      String
  city      String
  country   String
  region    String
  latitude  Float
  longitude Float
  timezone  String
  robots    Robot[]
  company   Company @relation(fields: [companyId], references: [id])
  companyId String

  @@index([companyId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(viewer)
  company      Company  @relation(fields: [companyId], references: [id])
  companyId    String
  createdAt    DateTime @default(now())

  @@index([companyId])
}

// Static inventory. Live state lives in Redis, keyed by the same robot id.
model Robot {
  id             String    @id
  kind           RobotKind
  serialNumber   String    @unique
  model          String
  firmware       String
  maxSpeedMps    Float
  batteryWh      Int
  site           Site      @relation(fields: [siteId], references: [id])
  siteId         String
  company        Company   @relation(fields: [companyId], references: [id])
  companyId      String
  commissionedAt DateTime  @default(now())

  @@index([companyId])
  @@index([siteId])
}
